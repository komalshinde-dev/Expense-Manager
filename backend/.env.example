# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/expense-manager

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRE=30d

# Google AI (Gemini)
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-gemini-api-key-here

# Optional: CORS Origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

STOCK_API_KEY=your-key-here
ALPHA_VANTAGE_KEY=your-key-here
BREVO_API_KEY=your-key-here


# Email Configuration (for Reminders & Notifications Feature)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=your_port
SMTP_USER=mail_id
SMTP_PASS=your_pass
SMTP_FROM_NAME=e-Khata Expense Manager
SMTP_FROM_EMAIL=your_mail
FRONTEND_URL=http://localhost:3000



